# One Caddy for every stack on the VPS (tech.md, 16.4). Values come from /opt/fabrika/edge/.env.
{
	email {$ACME_EMAIL}
}

import /etc/caddy/site.caddy

{$DOMAIN} {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	import fabrika fabrika-production {$PRODUCTION_ADMIN_PATH}
}

stage.{$DOMAIN} {
	basic_auth {
		{$STAGING_BASIC_AUTH_USER} {$STAGING_BASIC_AUTH_HASH}
	}
	header X-Robots-Tag "noindex, nofollow"
	import fabrika fabrika-staging {$STAGING_ADMIN_PATH}
}
